  52          /**
  53           * @brief 获取 rf 遥控器按键键值，供 key_driver 调用
  54           *          这里不能区分遥控器类型，只能获取遥控器按键
  55           *
  56           * @return u8
  57           */
  58          static u8 rf_key_get_key_id(void)
  59          {
  60   1          u8 ret = NO_KEY;
  61   1      
  62   1          if (0 == flag_is_recved_rf_data)
  63   1          {
  64   2              return NO_KEY;
  65   2          }
  66   1      
  67   1          flag_is_recved_rf_data = 0;
  68   1      
  69   1          if ((u8)(rf_data >> 16) != RF_KEY_ADDR_BYTE_1 ||
  70   1              (u8)(rf_data >> 8) != RF_KEY_ADDR_BYTE_2)
  71   1          {
  72   2              return NO_KEY;
  73   2          }
  74   1      
  75   1          ret = (u8)(rf_data & 0xFF); // 获取低8位作为键值
  76   1          // printf("rf_data 0x %lx\n", rf_data);
  77   1      
  78   1          // rf_data = 0;    // 接收完成后，清除接收到的数据
  79   1          return (u8)ret; // 直接获取键值
  80   1      }
