 308   4                      g_adcmax = 0;
 309   4                      g_adcmin = 0xFFFF;
 310   4                      g_tmpbuff = 0;
 311   4                      // printf("1 engine scan done\n");
 312   4                  }
 313   3              } 
 314   2              else if (ADC_STATUS_SEL_GET_TEMP == cur_adc_status)
 315   2              {
 316   3                  // 更新热敏电阻检测一端的ad值
 317   3                  adc_val_from_temp = adc_val;
 318   3                  // printf("3 temp scan done\n");
