 225          
 226          void fan_scan(void)
 227          {
 228   1          u16 adc_val = adc_val_from_fan; // adc_val_from_fan 由adc中断触发
 229   1      
 230   1          /*
 231   1              1脚电压低于4.3V时，14，15脚输出25%占空比，
 232   1              1脚电压高于4.5V时，14，15脚输出100%占空比
 233   1          */
 234   1          if (FAN_STATUS_NORMAL == cur_fan_status)
 235   1          {
 236   2              if (adc_val <= ADC_VAL_WHEN_FAN_ERR)
 237   2              {
 238   3                  flag_tim_scan_fan_is_err = 1; // 表示风扇异常，让定时器累计时间
 239   3              }
 240   2              else
 241   2              {
 242   3                  // 风扇正常时，只要有一次ad值不满足异常的条件，便认为它是正常工�
             -�
 243   3                  flag_tim_scan_fan_is_err = 0;
 244   3              }
 245   2      
 246   2              // 风扇正常工作，pwm正常输出
 247   2              limited_pwm_duty_due_to_fan_err = PWM_DUTY_100_PERCENT;
 248   2          }
 249   1          else // FAN_STATUS_ERROR == cur_fan_status
 250   1          {
 251   2              // 风扇异常时，检测到的ad值要与【风扇异常时对应的ad值】相隔一个死区�
             -��才认为风扇恢复正常
 252   2              if (adc_val >= ADC_VAL_WHEN_FAN_NORMAL)
 253   2              {
 254   3                  flag_tim_scan_fan_is_err = 0; // 表示风扇正常
 255   3              }
 256   2      
 257   2              // 风扇工作异常，限制pwm输出，占空比不超过25%
 258   2              limited_pwm_duty_due_to_fan_err = PWM_DUTY_25_PERCENT;
 259   2          }
 260   1      }
