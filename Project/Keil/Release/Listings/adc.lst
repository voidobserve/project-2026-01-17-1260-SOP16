 103          // 温度检测功能
 104          void temperature_scan(void)
 105          {
 106   1          volatile u32 voltage = 0; // 存放adc采集到的电压，单位：mV
 107   1      
 108   1          // 如果已经超过75摄氏度且超过5min，不用再检测8脚的电压，等待用户排查原�
             -�，再重启（重新上电）
 109   1          if (TEMP_75_5_MIN == temp_status)
 110   1          {
 111   2              return;
 112   2          }
 113   1      
 114   1          {
 115   2              // 调用该函数一定次数之后，才进行温度检测，缩短主循环的执行周期
 116   2              static volatile u8 cnt = 0;
 117   2              cnt++;
 118   2              if (cnt < 100)
 119   2              {
 120   3                  return;
 121   3              }
 122   2      
 123   2              cnt = 0;
 124   2          }
 125   1      
 126   1          voltage = get_voltage_from_pin(); // 得到热敏电阻上的电压
 127   1      
 128   1      #if USE_MY_DEBUG
                  // printf("PIN-8 voltage: %lu mV\n", voltage);
              #endif // USE_MY_DEBUG
 131   1      
 132   1          // 如果之前的温度为正常，检测是否超过75摄氏度（±5摄氏度）
 133   1          // if (TEMP_NORMAL == temp_status && voltage < VOLTAGE_TEMP_75)
 134   1          if (TEMP_NORMAL == temp_status)
 135   1          {
 136   2              // 如果检测到温度大于75摄氏度（测得的电压值要小于75摄氏度对应的电压�
             -��）
 137   2              static volatile u8 cnt = 0;
 138   2              if (voltage < VOLTAGE_TEMP_75) // 如果检测到温度大于75摄氏度（测得的电压值要�
             -�于75摄氏度对应的电压值）
 139   2              {
 140   3                  cnt++;
 141   3              }
 142   2              else
 143   2              {
 144   3                  cnt = 0;
 145   3              }
 146   2      
 147   2              if (cnt >= 10)
 148   2              {
 149   3                  cnt = 0;
 150   3                  // 测试的时候，如果引脚悬空，可能会执行不到这里：
 151   3                  temp_status = TEMP_75; // 状态标志设置为超过75摄氏度   USER_TO_DO  在测试时会
             -屏蔽掉
 152   3              }
 153   2              else
 154   2              {
 155   3                  temp_status = TEMP_NORMAL;
 156   3              }
 157   2      
 158   2              return; // 函数返回，让调节占空比的函数先进行调节
 159   2          }
