 160   1          else if (TEMP_75 == temp_status)
 161   1          {
 162   2              // 如果之前的温度超过75摄氏度
 163   2              static bit tmr1_is_open = 0;
 164   2      
 165   2              if (0 == tmr1_is_open)
 166   2              {
 167   3                  tmr1_is_open = 1;
