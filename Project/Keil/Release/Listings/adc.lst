 262          void ADC_IRQHandler(void) interrupt ADC_IRQn
 263          {
 264   1          // 进入中断设置IP，不可删除
 265   1          __IRQnIPnPush(ADC_IRQn);
 266   1      
 267   1          // ---------------- 用户函数处理 -------------------
 268   1       
 269   1      
 270   1          if (ADC_STA & ADC_CHAN0_DONE(0x01))
 271   1          {
 272   2              volatile u16 adc_val = (ADC_DATAH0 << 4) | (ADC_DATAL0 >> 4); // 先接收ad值
 273   2              ADC_STA |= ADC_CHAN0_DONE(0x01);                              // 清除ADC0转换完成标志位
 274   2      
 275   2              if (ADC_STATUS_SEL_ENGINE == cur_adc_status)
 276   2              {
 277   3                  // 更新发动机检测一端的ad值
 278   3      
